      "within_rate_cap": true,
      "run_after_within_window": true,
      "t_first": {
        "ready_s": 10,
        "at_s": 30
      }
    }
  },
  "expected": {
    "presence_parallel_active": true,
    "effective_rung": "semi"
  }
